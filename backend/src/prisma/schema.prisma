// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeEmpanada {
  SALEE
  SUCREE
  VEGETARIEN
}

enum TypeExtra {
  DOUCEUR
  BOISSON
}

enum StatutCommande {
  EN_ATTENTE_PAIEMENT
  VALIDEE
  RECUPEREE
  ANNULEE
  EXPIREE
  REMBOURSEE
}

enum ModeRecuperation {
  RETRAIT
  LIVRAISON
}

enum MotifRemboursement {
  STOCK_INSUFFISANT
  CAPACITE_DEPASSEE
  ERREUR_COMMANDE
  GESTE_COMMERCIAL
  AUTRE
}

enum StatutRemboursement {
  EN_COURS
  REUSSI
  ECHOUE
}

enum RoleUtilisateur {
  ADMIN
  EMPLOYE
}

// --- Catalogue ---

model Empanada {
  id                    Int           @id @default(autoincrement())
  nom                   String
  description           String
  type                  TypeEmpanada
  stock                 Int           @default(0)
  prixHt                Decimal       @db.Decimal(10, 2)
  tauxTva               Decimal       @default(5.5) @db.Decimal(4, 2)
  sansGluten            Boolean       @default(false)
  image_url             String?
  actif                 Boolean       @default(true)
  supplementFormuleTtc  Decimal       @default(0) @db.Decimal(10, 2)

  commandeEmpanadas CommandeEmpanada[]

  @@index([actif])
  @@map("empanadas")
}

model Extra {
  id                    Int        @id @default(autoincrement())
  nom                   String
  description           String
  type                  TypeExtra
  stock                 Int        @default(0)
  tauxTva               Decimal    @default(5.5) @db.Decimal(4, 2)
  prixHt                Decimal    @db.Decimal(10, 2)
  sansGluten            Boolean?   @default(false)
  image_url             String?
  actif                 Boolean    @default(true)
  supplementFormuleTtc  Decimal    @default(0) @db.Decimal(10, 2)

  commandeExtras CommandeExtra[]

  @@index([actif])
  @@map("extras")
}

model Formule {
  id              Int      @id @default(autoincrement())
  nom             String
  description     String
  prixTtc         Decimal  @db.Decimal(10, 2)   // prix fixe TTC, ex 18.90
  image_url       String?
  actif           Boolean  @default(true)
  nombreEmpanadas Int      // quota d'empanadas à choisir
  nombreExtras    Int      @default(0)          // quota d'extras à choisir

  commandeFormules CommandeFormule[]

  @@index([actif])
  @@map("formules")
}

// --- Clients / admin ---

model Utilisateur {
  id         Int             @id @default(autoincrement())
  nom        String
  email      String          @unique
  motDePasse String
  role       RoleUtilisateur @default(EMPLOYE)
  creeLe     DateTime        @default(now())

  @@map("utilisateurs")
}

model Client {
  id             Int      @id @default(autoincrement())
  nom            String
  email          String   @unique
  motDePasse     String
  telephone      String?
  pointsFidelite Int      @default(0)
  creeLe         DateTime @default(now())

  commandes Commande[]

  @@map("clients")
}

model StripeEvenement {
  id       String   @id          // event.id Stripe (evt_...)
  type     String
  traiteLe DateTime @default(now())

  @@map("stripe_evenements")
}

// --- Commandes ---

model CodePromo {
  id            Int       @id @default(autoincrement())
  code          String    @unique            // "DORADA10", stocké en majuscules
  pourcentage   Decimal   @db.Decimal(5, 2)  // 10, 15, 20
  actif         Boolean   @default(true)
  dateExpiration DateTime?
  usagesMax     Int?                          // null = illimité
  usagesActuels Int       @default(0)
  creeLe     DateTime  @default(now())

  commandes     Commande[]
}

model Commande {
  id               Int              @id @default(autoincrement())
  reference        String           @unique
  clientNom        String
  clientEmail      String
  clientTelephone  String
  statut           StatutCommande   @default(EN_ATTENTE_PAIEMENT)
  modeRecuperation ModeRecuperation
  adresseLivraison String?
  dateSouhaitee    DateTime
  creeLe           DateTime         @default(now())

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId Int?

  // Source de vérité des montants : toujours la somme des lignes, calculée côté serveur
  totalHt  Decimal @db.Decimal(10, 2)
  totalTva Decimal @db.Decimal(10, 2)
  totalTtc Decimal @db.Decimal(10, 2)

  empanadas      CommandeEmpanada[]   // empanadas à l'unité (hors formule)
  extras         CommandeExtra[]      // extras à l'unité (hors formule)
  formules       CommandeFormule[]
  remboursements Remboursement[]

  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  payeeLe               DateTime?

  codePromoId   Int?
  codePromo     CodePromo? @relation(fields: [codePromoId], references: [id])
  codePromoFige String?                       // snapshot du code, comme ton nomFige
  remisePourcent Decimal?  @db.Decimal(5, 2)
  remiseTtc     Decimal   @default(0) @db.Decimal(10, 2)

  @@index([statut, dateSouhaitee])
  @@index([clientId])
  @@map("commandes")
}

// Une formule commandée (prix fixe + suppléments)
model CommandeFormule {
  id              Int      @id @default(autoincrement())
  commande        Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  commandeId      Int
  formule         Formule  @relation(fields: [formuleId], references: [id])
  formuleId       Int
  quantite        Int
  nomFige         String
  prixUnitaireTtc Decimal  @db.Decimal(10, 2)  // prix fixe + suppléments, par unité
  totalHt         Decimal  @db.Decimal(10, 2)
  totalTva        Decimal  @db.Decimal(10, 2)
  totalTtc        Decimal  @db.Decimal(10, 2)

  empanadasChoisies CommandeEmpanada[]
  extrasChoisies    CommandeExtra[]

  @@index([commandeId])
  @@map("commande_formules")
}

// Une ligne = une empanada à l'unité (commandeFormuleId null) ou un choix de formule (quantite = 1)
model CommandeEmpanada {
  id                Int      @id @default(autoincrement())
  commande          Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  commandeId        Int
  empanada          Empanada @relation(fields: [empanadaId], references: [id])
  empanadaId        Int
  quantite          Int
  nomFige           String
  prixUnitaireHt    Decimal  @db.Decimal(10, 2)
  tauxTva           Decimal  @db.Decimal(4, 2)
  supplementTtc     Decimal  @default(0) @db.Decimal(10, 2)
  totalHt           Decimal  @db.Decimal(10, 2)
  totalTva          Decimal  @db.Decimal(10, 2)
  totalTtc          Decimal  @db.Decimal(10, 2)

  commandeFormule   CommandeFormule? @relation(fields: [commandeFormuleId], references: [id], onDelete: Cascade)
  commandeFormuleId Int?

  @@index([commandeId])
  @@index([commandeFormuleId])
  @@map("commande_empanadas")
}

model CommandeExtra {
  id                Int      @id @default(autoincrement())
  commande          Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  commandeId        Int
  extra             Extra    @relation(fields: [extraId], references: [id])
  extraId           Int
  quantite          Int
  nomFige           String
  prixUnitaireHt    Decimal  @db.Decimal(10, 2)
  tauxTva           Decimal  @db.Decimal(4, 2)
  supplementTtc     Decimal  @default(0) @db.Decimal(10, 2)
  totalHt           Decimal  @db.Decimal(10, 2)
  totalTva          Decimal  @db.Decimal(10, 2)
  totalTtc          Decimal  @db.Decimal(10, 2)

  commandeFormule   CommandeFormule? @relation(fields: [commandeFormuleId], references: [id], onDelete: Cascade)
  commandeFormuleId Int?

  @@index([commandeId])
  @@index([commandeFormuleId])
  @@map("commande_extras")
}

// --- Remboursements ---

model Remboursement {
  id             Int                 @id @default(autoincrement())
  commande       Commande            @relation(fields: [commandeId], references: [id])
  commandeId     Int
  montant        Decimal             @db.Decimal(10, 2)
  motif          MotifRemboursement
  commentaire    String?
  statut         StatutRemboursement @default(EN_COURS)
  stripeRefundId String?             @unique
  idempotencyKey String              @unique @default(uuid())
  demandeParId   Int
  demandeParNom  String
  creeLe         DateTime            @default(now())
  traiteLe       DateTime?

  @@index([commandeId])
  @@map("remboursements")
}