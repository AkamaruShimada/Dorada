generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeEmpanada {
  SALEE
  SUCREE
  VEGETARIEN
}

enum TypeExtra {
  DOUCEUR
  BOISSON
}

enum StatutCommande {
  EN_ATTENTE
  VALIDEE
  RECUPEREE
  ANNULEE
}

enum ModeRecuperation {
  RETRAIT
  LIVRAISON
}

enum RoleUtilisateur {
  ADMIN
  EMPLOYE
}

model Empanada {
  id          Int           @id @default(autoincrement())
  nom         String
  description String
  type        TypeEmpanada
  stock       Int           @default(0)
  prixHt      Decimal @db.Decimal(10, 2)
  tauxTva     Decimal @default(5.5) @db.Decimal(4, 2)
  sansGluten  Boolean       @default(false)
  image_url   String?       
  actif       Boolean       @default(true)

  commandeEmpanadas CommandeEmpanada[]

  @@index([actif])

  @@map("empanadas")
}

model Extra {
  id          Int      @id @default(autoincrement())
  nom         String
  description String
  type        TypeExtra
  stock       Int          @default(0)
  tauxTva     Decimal @default(5.5) @db.Decimal(4, 2)
  prixHt      Decimal @db.Decimal(10, 2)
  sansGluten  Boolean?       @default(false)
  image_url   String?
  actif       Boolean  @default(true)

  commandeExtras CommandeExtra[]

  @@map("extras")
}

model Formule {
  id          Int      @id @default(autoincrement())
  nom         String
  description String
  prixHt      Decimal @db.Decimal(10, 2)
  image_url   String?
  actif       Boolean  @default(true)

  nombreEmpanadas   Int      // ex: 2, 3, 6, 12 — quota que le client doit remplir
  nombreExtras      Int      @default(0) // ex: 1 boisson + 1 douceur = 2, ou 1 seul

  commandeFormules CommandeFormule[]

  @@map("formules")
}

