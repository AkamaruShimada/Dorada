model Utilisateur {
  id           Int             @id @default(autoincrement())
  nom          String
  email        String          @unique
  motDePasse   String
  role         RoleUtilisateur @default(EMPLOYE)
  creeLe       DateTime        @default(now())

  @@map("utilisateurs")
}

model Client {
  id              Int       @id @default(autoincrement())
  nom             String
  email           String    @unique
  motDePasse      String
  telephone       String?
  pointsFidelite  Int       @default(0)
  creeLe          DateTime  @default(now())

  commandes Commande[]

  @@map("clients")
}

model Commande {
  id                Int              @id @default(autoincrement())
  reference         String           @unique
  clientNom         String
  clientEmail       String
  clientTelephone   String
  statut            StatutCommande   @default(EN_ATTENTE)
  modeRecuperation  ModeRecuperation
  adresseLivraison  String?          // rempli seulement si LIVRAISON
  dateSouhaitee     DateTime
  creeLe            DateTime         @default(now())

  client            Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId          Int?

  totalHt   Decimal @db.Decimal(10, 2)
  totalTva  Decimal @db.Decimal(10, 2)
  totalTtc  Decimal @db.Decimal(10, 2)

  empanadas CommandeEmpanada[]
  extras    CommandeExtra[]
  formules  CommandeFormule[]

  @@index([statut, dateSouhaitee])
  @@index([clientId])

  @@map("commandes")
}

// Chaque ligne = une empanada commandée à l'unité (hors formule)
model CommandeEmpanada {
  id            Int      @id @default(autoincrement())
  commande      Commande @relation(fields: [commandeId], references: [id])
  commandeId    Int
  empanada      Empanada @relation(fields: [empanadaId], references: [id])
  empanadaId    Int
  quantite      Int
  prixUnitaireHt Decimal  @db.Decimal(10, 2)  // obligatoire, plus de "?"
  tauxTva        Decimal  @db.Decimal(4, 2)   // obligatoire

  commandeFormule CommandeFormule? @relation(fields: [commandeFormuleId], references: [id])
  commandeFormuleId Int?

  @@map("commande_empanadas")
}

model CommandeExtra {
  id            Int      @id @default(autoincrement())
  commande      Commande @relation(fields: [commandeId], references: [id])
  commandeId    Int
  extra         Extra    @relation(fields: [extraId], references: [id])
  extraId       Int
  quantite      Int
  prixUnitaireHt Decimal  @db.Decimal(10, 2)  // obligatoire, plus de "?"
  tauxTva        Decimal  @db.Decimal(4, 2)   // obligatoire

  commandeFormule    CommandeFormule? @relation(fields: [commandeFormuleId], references: [id])
  commandeFormuleId  Int?

  @@map("commande_extras")
}

// Chaque ligne = une formule commandée
model CommandeFormule {
  id            Int      @id @default(autoincrement())
  commande      Commande @relation(fields: [commandeId], references: [id])
  commandeId    Int
  formule       Formule  @relation(fields: [formuleId], references: [id])
  formuleId     Int
  quantite      Int
  prixUnitaireHt Decimal  @db.Decimal(10, 2)  // obligatoire, plus de "?"

  empanadasChoisies CommandeEmpanada[] // les empanadas de CETTE formule commandée
  extrasChoisis     CommandeExtra[]

  @@map("commande_formules")
}